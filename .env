# ---------------------------------------------------------------------------
# Shared defaults for every build (local dev AND the deployed site).
#
# These demo credentials are intentionally public: they belong to the
# resettable sample accounts described in README.md, and the sign-in screen
# shows them anyway. Keep them in sync with the server-side demo seed.
#
# NOTE: VITE_API_BASE_URL is deliberately NOT set here. Vite inlines whatever
# it finds into the production bundle, so a committed localhost URL made the
# deployed site call the visitor's own machine (works on the developer laptop,
# fails on phones). Local dev reads .env.development; production uses the
# deployed API by default, or VITE_API_BASE_URL from the Vercel dashboard.
# ---------------------------------------------------------------------------
VITE_DEMO_ADMIN_USERNAME=demo-admin
VITE_DEMO_ADMIN_PASSWORD=8e25d4a1
VITE_DEMO_FACULTY_USERNAME=demo-faculty
VITE_DEMO_FACULTY_PASSWORD=8e25d4a1
VITE_DEMO_STUDENT_USERNAME=demo-student
VITE_DEMO_STUDENT_PASSWORD=8e25d4a1
