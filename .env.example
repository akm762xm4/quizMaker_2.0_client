# Base URL of the QuizMaker API, including /api.
#
# Local dev default:  http://localhost:8000/api   (see .env.development)
# Production default: https://quiz-maker-2-0-server.vercel.app/api
#
# Set this in your hosting provider's dashboard to override the production
# default. Never point a deployed build at localhost/127.0.0.1: phones would
# try to reach their own device, login would fail, and Chrome on Android warns
# that the site "wants to access other apps and services on this device".
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: only set these if you change the names/password created by the demo seed.
VITE_DEMO_ADMIN_USERNAME=demo-admin
VITE_DEMO_ADMIN_PASSWORD=DemoPass123!
VITE_DEMO_FACULTY_USERNAME=demo-faculty
VITE_DEMO_FACULTY_PASSWORD=DemoPass123!
VITE_DEMO_STUDENT_USERNAME=demo-student
VITE_DEMO_STUDENT_PASSWORD=DemoPass123!
